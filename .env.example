# Local integration test database only; do not use this password in production.
DATABASE_URL=postgres://brokerrouter:brokerrouter-local-only@127.0.0.1:55432/brokerrouter
BROKERROUTER_BIND=127.0.0.1:8080
RUST_LOG=brokerrouter=info
# Required for `serve`: inject these through your Secret manager. Do not use test keys.
# BROKERROUTER_ACTIVE_RESULT_KEY=<KEY_ID>
# BROKERROUTER_RESULT_KEYS={"<KEY_ID>":"<64_HEX_CHARACTERS>"}
# Required only by the isolated MCP catalog/client processes. Use a different
# key ring from result encryption; values are injected by the secret manager.
# BROKERROUTER_ACTIVE_MCP_CONFIG_KEY=<KEY_ID>
# BROKERROUTER_MCP_CONFIG_KEYS={"<KEY_ID>":"<64_HEX_CHARACTERS>"}
# MCP client only: URI-to-injected-variable bindings contain no secret values.
# BROKERROUTER_MCP_SECRET_ENV_BINDINGS=[{"reference":"vault://production/mcp/tools","environment":"MCP_TOOLS_OAUTH"}]
# Optional enterprise/private PKI roots; certificate and hostname checks remain enabled.
# BROKERROUTER_MCP_CA_BUNDLE=/etc/brokerrouter/mcp-ca-bundle.pem
# MCP client only: versioned, read-only, SHA-256-pinned stdio launcher registry.
# BROKERROUTER_MCP_STDIO_LAUNCHERS_FILE=/etc/brokerrouter/mcp-stdio-launchers.json
# Required by `serve-mcp`; JSON arrays use exact authorities/origins. An empty
# origin list rejects every request that carries an Origin header.
# BROKERROUTER_MCP_ALLOWED_HOSTS=["gateway.example.com"]
# BROKERROUTER_MCP_ALLOWED_ORIGINS=["https://console.example.com"]
# Optional OAuth Protected Resource mode; RESOURCE and ISSUERS are all-or-none.
# Access-token `aud` must be exactly RESOURCE. Remote JWKS defaults to public
# network only; set allow_private only for an explicitly isolated enterprise IdP.
# BROKERROUTER_MCP_RESOURCE=https://gateway.example.com/mcp
# BROKERROUTER_MCP_OAUTH_ISSUERS=[{"issuer":"https://identity.example/tenant","jwks_uri":"https://identity.example/tenant/jwks","allow_private":false}]
# BROKERROUTER_MCP_OAUTH_MAX_TOKEN_SECONDS=3600
BROKERROUTER_MAX_CONCURRENCY=64
BROKERROUTER_REQUEST_TIMEOUT_SECONDS=120
BROKERROUTER_RESULT_TTL_SECONDS=86400
# Required only for the separately deployed `serve-control` process.
# DATABASE_URL must use brokerrouter_governance_control there, never the runtime login.
# BROKERROUTER_HUMAN_ISSUER=https://your-trusted-bff.example
# BROKERROUTER_HUMAN_AUDIENCE=brokerrouter-human-control
# BROKERROUTER_HUMAN_PUBLIC_KEYS={"<KID>":"<RSA_PUBLIC_KEY_PEM>"}
# The BFF private signing key and browser session MUST NOT enter either Agent tools or model context.
# Optional independent `serve-approvals` listener; see docs/m5-human-approval-workbench.md.
# BROKERROUTER_APPROVALS_ISSUER=https://your-trusted-bff.example
# BROKERROUTER_APPROVALS_AUDIENCE=brokerrouter-approvals
# BROKERROUTER_APPROVALS_PUBLIC_KEYS={"<KID>":"<RSA_PUBLIC_KEY_PEM>"}
# BFF-only: all four required together, separate key/audience from other purposes.
# BROKERROUTER_BFF_APPROVALS_ORIGIN=https://private-approvals.example
# BROKERROUTER_BFF_APPROVALS_SIGNING_KID=<APPROVALS_KID>
# BROKERROUTER_BFF_APPROVALS_SIGNING_PRIVATE_KEY=<RSA_PRIVATE_KEY_FROM_SECRET_MANAGER>
# Optional read-only `serve-media-review`; independent DB login + GetObject-only IAM.
# BROKERROUTER_MEDIA_REVIEW_ISSUER=https://console.example.invalid
# BROKERROUTER_MEDIA_REVIEW_AUDIENCE=brokerrouter-media-review
# BROKERROUTER_MEDIA_REVIEW_PUBLIC_KEYS={"<KID>":"<RSA_PUBLIC_KEY_PEM>"}
# BFF-only: these five settings (including AUDIENCE above) are all-or-none.
# Requires APPROVALS configured; separate RSA key and audience from every other target.
# BROKERROUTER_BFF_MEDIA_REVIEW_ORIGIN=https://private-media-review.example.invalid
# BROKERROUTER_BFF_MEDIA_REVIEW_SIGNING_KID=<MEDIA_REVIEW_KID>
# BROKERROUTER_BFF_MEDIA_REVIEW_SIGNING_PRIVATE_KEY=<RSA_PRIVATE_KEY_FROM_SECRET_MANAGER>
# BROKERROUTER_BFF_MEDIA_PREVIEW_ORIGIN=https://review.example-media.invalid
# Publish only preview/ on that independent, credential-free site; see deployment guide.
